{
  "warnAt": 400,
  "failAt": 600,
  "countBlankLines": false,
  "countCommentLines": true,
  "includeExtensions": [
    ".cs",
    ".cshtml",
    ".razor",
    ".js",
    ".jsx",
    ".ts",
    ".tsx",
    ".py",
    ".java",
    ".go",
    ".rs",
    ".cpp",
    ".c",
    ".h",
    ".hpp",
    ".css",
    ".scss",
    ".html",
    ".sql",
    ".sh",
    ".ps1"
  ],
  "exclude": [
    "**/.git/**",
    "**/.vs/**",
    "**/.idea/**",
    "**/.vscode/**",
    "**/bin/**",
    "**/obj/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/generated/**",
    "**/Generated/**",
    "**/vendor/**",
    "**/Vendor/**",
    "**/Migrations/**",
    "**/*.g.cs",
    "**/*.generated.cs",
    "**/*.Designer.cs",
    "**/*.designer.cs",
    "**/*.min.js",
    "**/*.min.css",
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/yarn.lock"
  ],
  "allowedLargeFiles": []
}
